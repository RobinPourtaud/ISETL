{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": { "@isetl/runtime": ["./packages/runtime/src/index.ts"] }
  },
  "include": ["apps/web/src", "apps/web/vite.config.ts", "packages/runtime/src"]
}
